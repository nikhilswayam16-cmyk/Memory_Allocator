#include<iostream>
#include<cstddef>
#include<new>
using namespace std;
struct block{
size_t size;
block* next;
};
void* allocate(block*& free_hand, size_t requested_size)
{
if(free_hand->next == nullptr) return nullptr;
if(requested_size > free_hand->size) return nullptr;

}
int main()
{
alignas(block) byte arena[4096];
block* A = new (arena) block {4096,nullptr};
block* free_hand = A;
cout<<sizeof(arena);
cout<<'\n';
cout<<free_hand->size<<'\n';
cout<<sizeof(block)<<'\n';
if(free_hand->next == nullptr) cout<<1<<'\n';
return 0;
}
